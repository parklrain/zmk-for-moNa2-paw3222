#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        combo_lpar {
            bindings = <&kp LPAR>;
            key-positions = <2 3>;
        };

        combo_rpar {
            bindings = <&kp RPAR>;
            key-positions = <6 7>;
        };

        combo_next {
            bindings = <&mkp MB5>;
            key-positions = <16 28>;
        };

        combo_prev {
            bindings = <&mkp MB4>;
            key-positions = <17 29>;
        };

        combo_lclk {
            bindings = <&mkp LCLK>;
            key-positions = <18 30>;
        };

        combo_rclk {
            bindings = <&mkp RCLK>;
            key-positions = <19 31>;
        };

        combo_mclk {
            bindings = <&mkp MCLK>;
            key-positions = <30 31>;
        };

        combo_bapc {
            bindings = <&kp BSPC>;
            key-positions = <9 20>;
        };

        combo_enter {
            bindings = <&kp ENTER>;
            key-positions = <20 32>;
        };

        combo_lang {
            bindings = <&kp RALT>;
            key-positions = <17 19>;
        };

        combo_hanja {
            bindings = <&kp RCTRL>;
            key-positions = <18 20>;
        };

        combo_esc {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
        };

        combo_undo {
            bindings = <&kp LC(Z)>;
            key-positions = <10 21>;
        };

        combo_cut {
            bindings = <&kp LC(X)>;
            key-positions = <11 22>;
        };

        combo_copy {
            bindings = <&kp LC(C)>;
            key-positions = <12 23>;
        };

        combo_paste {
            bindings = <&kp LC(V)>;
            key-positions = <13 24>;
        };

        combo_fnc {
            bindings = <&mo 3>;
            key-positions = <39 40>;
        };
    };

    behaviors {
        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            label = "HM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            quick-tap-ms = <180>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
            tapping-term-ms = <300>;
        };

        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
        };

        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        hmr: homerow_right_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_RIGHT_MODS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 21 22 23 24 25 36 37 38 39 40>;
            hold-trigger-on-release;
        };

        hml: homerow_left_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_LEFT_MODS";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <5 6 7 8 9 16 17 18 19 20 28 29 30 31 32 36 37 38 39 40>;
            hold-trigger-on-release;
        };

        sk_shft: sk_shft {
            compatible = "zmk,behavior-sticky-key";
            label = "SK_SHFT";
            bindings = <&kp>;
            #binding-cells = <1>;
            release-after-ms = <1000>;
            quick-release;
        };

        magic_shft_tap: magic_shft_tap {
            compatible = "zmk,behavior-mod-morph";
            label = "MAGIC_SHFT_TAP";
            bindings = <&sk_shft LSHFT>, <&caps_word>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        magic_shft: magic_shft {
            compatible = "zmk,behavior-hold-tap";
            label = "MAGIC_SHFT";
            bindings = <&kp>, <&magic_shft_tap>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "balanced";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q            &kp W            &kp E         &kp R         &kp T                                                    &kp Y        &kp U         &kp I         &kp O        &kp P
&hml LEFT_GUI A  &hml LEFT_ALT S  &hml LSHFT D  &hml LCTRL F  &kp G                               &kp PAGE_UP          &kp H        &hmr LCTRL J  &hmr RSHFT K  &hmr LALT L  &hmr RIGHT_GUI SEMICOLON
&kp Z            &kp X            &kp C         &kp V         &kp B             &mo 5             &lt 2 B              &kp N        &kp M         &ltq 5 COMMA  &ltq 5 DOT   &ltq 5 SLASH
&kp LCTRL        &kp LALT         &kp LEFT_GUI  &ltq 3 TAB    &ltq 1 BACKSPACE  &ltq 2 ENTER      &magic_shft LSHFT 0  &lt 1 SPACE                                           &kp RCTRL
            >;

            sensor-bindings = <&scroll_up_down>;
            display-name = "BASE";
        };

        Num_layer {
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5                                &kp NUMBER_6     &kp N7     &kp N8     &kp N9  &kp N0
&trans        &trans        &trans        &kp LC(F5)    &kp F12              &trans           &kp MINUS        &kp EQUAL  &kp GRAVE  &trans  &kp SQT
&trans        &trans        &trans        &trans        &trans   &trans      &trans           &trans           &trans     &trans     &trans  &trans
&trans        &trans        &trans        &trans        &trans   &trans      &kp RIGHT_SHIFT  &kp RIGHT_SHIFT                                &trans
            >;

            sensor-bindings = <&scroll_up_down>;
            display-name = "NUM";
        };

        Sym_layer {
            bindings = <
&kp ESC   &trans  &trans  &trans  &trans                      &trans  &kp HOME        &kp UP_ARROW  &kp END    &bootloader
&kp CAPS  &trans  &trans  &trans  &trans              &trans  &trans  &kp LEFT_ARROW  &kp DOWN      &kp RIGHT  &kp DELETE
&trans    &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans          &trans        &trans     &trans
&trans    &trans  &trans  &trans  &trans  &trans      &trans  &trans                                           &trans
            >;

            sensor-bindings = <&scroll_up_down>;
            display-name = "SYM";
        };

        Fnc_layer {
            bindings = <
&trans  &trans    &trans    &trans     &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &mkp MB1  &mkp MB3  &mkp MB2   &trans              &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans    &trans    &trans     &trans  &trans      &trans  &trans  &mkp MB4  &trans    &mkp MB5  &trans
&trans  &trans    &trans    &kp LCTRL  &trans  &trans      &trans  &trans                                &trans
            >;

            sensor-bindings = <&scroll_up_down>;
            display-name = "FNC";
        };

        Sys_layer {
            bindings = <
&kp F1  &trans  &trans  &trans  &trans                      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans
&trans  &trans  &trans  &trans  &trans              &trans  &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                  &trans
            >;

            sensor-bindings = <&scroll_up_down>;
            display-name = "SYS";
        };

        Scroll_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans              &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
            display-name = "SCR";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Sys_layer {
            if-layers = <1 2>;
            then-layer = <4>;
        };
    };
};
